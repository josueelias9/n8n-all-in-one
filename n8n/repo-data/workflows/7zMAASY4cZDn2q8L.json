      "id": "da149188-e772-44d7-b8d2-979fef4d6c15",
      "name": "Ollama Chat Model3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "position": [
        1792,
        896
      ],
      "typeVersion": 1
