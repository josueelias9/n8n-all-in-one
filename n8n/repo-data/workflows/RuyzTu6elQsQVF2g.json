      "id": "e3586e6b-bd11-46dd-a326-6c21bcf24b39",
      "name": "Ollama Chat Model3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "position": [
        1888,
        1088
      ],
      "typeVersion": 1,
