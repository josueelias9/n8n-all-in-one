      "parameters": {
        "content": "# Turn voice messages into structured emails and calendar events with AI-powered automation and human approval via Telegram.",
        "width": 4032
      },
      "id": "f51bb286-0a24-475a-999b-882ee0afea42",
      "name": "Sticky Note1",
      "type": "n8n-nodes-base.stickyNote",
      "position": [
